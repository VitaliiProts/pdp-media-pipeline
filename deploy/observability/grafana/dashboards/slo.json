{
  "uid": "pdp-slo",
  "title": "SLO",
  "description": "Latency SLO per job type: objective, SLI, error budget and burn rates behind the alerts.",
  "tags": ["pdp", "metrics"],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": ["pdp"],
      "asDropdown": false,
      "title": "PDP",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "type",
        "label": "Job type",
        "type": "custom",
        "query": "image.resize,video.frames,video.transcode",
        "current": {
          "text": "image.resize",
          "value": "image.resize"
        },
        "options": [
          {
            "text": "image.resize",
            "value": "image.resize",
            "selected": true
          },
          {
            "text": "video.frames",
            "value": "video.frames",
            "selected": false
          },
          {
            "text": "video.transcode",
            "value": "video.transcode",
            "selected": false
          }
        ]
      },
      {
        "name": "le",
        "label": "Threshold, s",
        "description": "The type's SLO threshold: the le label of job:slo_objective:ratio.",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(job:slo_objective:ratio{type=\"$type\"}, le)",
          "refId": "le"
        },
        "definition": "label_values(job:slo_objective:ratio{type=\"$type\"}, le)",
        "refresh": 1,
        "current": {
          "text": "300",
          "value": "300"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "$type, 30 days",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Objective",
      "description": "Share of jobs that must succeed within $le s of creation: 5 min for images and frames (ADR-001, ADR-008), 10 min for transcoding (ADR-011).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "job:slo_objective:ratio{type=\"$type\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI, 30 days",
      "description": "Succeeded within $le s / finished, without permanent failures (rejected input).",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(job_e2e_duration_seconds_bucket{type=\"$type\", outcome=\"succeeded\", le=\"$le\"}[30d])) / sum(increase(job_e2e_duration_seconds_count{type=\"$type\", outcome!=\"permanent\"}[30d]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget left",
      "description": "Share of the 30-day budget not spent yet. Below zero the SLO is broken.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - (1 - (sum(increase(job_e2e_duration_seconds_bucket{type=\"$type\", outcome=\"succeeded\", le=\"$le\"}[30d])) / sum(increase(job_e2e_duration_seconds_count{type=\"$type\", outcome!=\"permanent\"}[30d])))) / (1 - scalar(job:slo_objective:ratio{type=\"$type\"}))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
