      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (type) (rate(jobs_finished_total{outcome!=\"succeeded\"}[$__rate_interval])) / sum by (type) (rate(jobs_finished_total[$__rate_interval]))",
          "legendFormat": "{{type}} dead"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (type) (rate(jobs_retries_total[$__rate_interval])) * 60",
          "legendFormat": "{{type}} retries/min"
        }
