{
  "uid": "pdp-job",
  "title": "Job",
  "description": "Trace and logs of one job across all services. Opened from the job card in the web UI.",
  "tags": ["pdp", "tracing"],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "job_id",
        "label": "Job ID",
        "type": "textbox",
        "query": "none",
        "current": {
          "text": "none",
          "value": "none"
        }
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "none",
        "current": {
          "text": "none",
          "value": "none"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Trace",
      "description": "The request that created or last redrove the job, through scheduler and workers to the webhook deliveries. Empty when the link carried no trace id; the table below still finds the job's traces.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceId",
          "query": "$trace_id"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "description": "Log lines tagged with the job, or written inside its trace (e.g. the request before the job had an id). Click trace_id to open the trace.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "queryType": "instant",
          "expr": "job_id:=\"$job_id\" OR trace_id:=\"$trace_id\""
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "All traces of this job",
      "description": "Every trace with a span tagged job.id: the original run and each redrive.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "query": "{ span.job.id = \"$job_id\" }"
        }
      ]
    }
  ]
}
