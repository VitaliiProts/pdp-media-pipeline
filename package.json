{
  "name": "pdp-media-pipeline",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./libs/**\" build",
    "typecheck": "pnpm build:libs && pnpm -r typecheck && tsc -p test/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "pnpm build:libs && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps libs --config .dependency-cruiser.cjs",
    "helm:lint": "scripts/helm-check.sh",
    "alerts:test": "docker run --rm -v \"$PWD/deploy/observability/vmalert:/vmalert:ro\" victoriametrics/vmalert-tool:v1.154.0 unittest --files=/vmalert/tests/alerts.test.yml",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "k8s:up": "scripts/k8s.sh up",
    "k8s:deploy": "scripts/k8s.sh deploy",
    "k8s:down": "scripts/k8s.sh down",
    "prepare": "husky",
    "test": "pnpm build:libs && jest",
    "test:cov": "pnpm build:libs && jest --coverage",
    "test:int": "pnpm build:libs && jest -c jest.int.config.js",
    "test:pact": "pnpm build:libs && rm -rf pacts && jest -c jest.pact.config.js",
    "test:web": "pnpm --filter @pdp/web test",
    "test:tools": "node --test 'perf/**/*.test.mjs' 'scripts/*.test.mjs'",
    "dev:web": "pnpm --filter @pdp/web dev",
    "test:web:cov": "pnpm --filter @pdp/web test:cov",
    "test:e2e": "scripts/e2e.sh",
    "coverage": "node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@nats-io/jetstream": "^3.4",
    "@nats-io/transport-node": "^3.4",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@opentelemetry/api": "^1.9.1",
    "@pact-foundation/pact": "17.1.4",
    "@pdp/contracts": "workspace:^",
    "@pdp/metadata-client": "workspace:^",
    "@pdp/observability": "workspace:^",
    "@pdp/worker-kit": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
