{
  "name": "pdp-media-pipeline",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./libs/**\" build",
    "typecheck": "pnpm build:libs && pnpm -r typecheck && tsc -p test/tsconfig.json",
    "lint": "pnpm build:libs && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps libs --config .dependency-cruiser.cjs",
    "helm:lint": "for c in deploy/helm/*/; do helm lint \"$c\" || exit 1; done",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "prepare": "husky",
    "test": "pnpm build:libs && jest",
    "test:cov": "pnpm build:libs && jest --coverage",
    "test:int": "pnpm build:libs && jest -c jest.int.config.js",
    "test:web": "pnpm --filter @pdp/web test",
    "dev:web": "pnpm --filter @pdp/web dev"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@eslint/js": "^10.0.1",
    "@nats-io/jetstream": "^3.4",
    "@nats-io/transport-node": "^3.4",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@pdp/contracts": "workspace:^",
    "@pdp/metadata-client": "workspace:^",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
