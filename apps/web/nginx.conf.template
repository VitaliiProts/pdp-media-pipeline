# Rendered by the image entrypoint with envsubst; only ${GATEWAY_URL} and ${GRAFANA_URL}
# are defined, so nginx's own $variables are left untouched.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # The API stays same-origin for the browser, so the gateway needs no CORS.
    location /v1/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
    }

    # Runtime settings for the SPA; an empty GRAFANA_URL hides the trace links.
    location = /config.json {
        add_header Cache-Control "no-cache";
        default_type application/json;
        return 200 '{"grafanaUrl":"${GRAFANA_URL}"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed file names, safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
