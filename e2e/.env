# Read instead of the root .env (scripts/e2e.sh passes --env-file), so no provider key of a
# developer's machine reaches the stack under test.
WEB_HOST_PORT=28090
MINIO_HOST_PORT=29000

# Every test registers its own user from the same address.
AUTH_IP_RATE_PER_MIN=600
AUTH_IP_BURST=600
AUTH_EMAIL_RATE_PER_MIN=60
AUTH_EMAIL_BURST=60
RATE_LIMIT_IP_RPS=200
RATE_LIMIT_IP_BURST=400
RATE_LIMIT_USER_RPS=100
RATE_LIMIT_USER_BURST=200
